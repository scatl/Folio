# Folio 一体镜像环境变量（群晖 Docker「环境变量」或 compose 使用）

# 数据库（容器内 MariaDB；一般只需改密码）
MYSQL_DATABASE=folio
MYSQL_USER=folio
MYSQL_PASSWORD=请改成强密码
MYSQL_ROOT_PASSWORD=请改成强密码

# 可选：覆盖 JDBC（默认连容器内 127.0.0.1）
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/folio?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
# SPRING_DATASOURCE_USERNAME=folio
# SPRING_DATASOURCE_PASSWORD=请改成强密码

# TMDB / OMDb / TVDB 与刮削选项在登录后的设置页填写，保存在数据库

# JVM
JAVA_OPTS=-Xms256m -Xmx512m
SERVER_PORT=32700

# 容器时区，日志按这个时区写。数据库仍用 UTC。
TZ=Asia/Shanghai

# 日志。容器内默认写到挂载的 /data/logs，只保留最近 7 天
# FOLIO_LOG_FILE=/data/logs/folio.log
